{
  "name": "beepstock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fridge barcode scanner app: stock, shopping list, waste tracking, Open Food Facts",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@zxing/library": "^0.23.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "jsbarcode": "^3.11.6",
    "pg": "^8.12.0",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
