# Copy to ".env" (git-ignored) and adjust. docker compose reads it automatically.

# Keeps volume and container names stable no matter which folder the project lives in (recommended on a server).
COMPOSE_PROJECT_NAME=beepstock

# Database password. CHANGE THIS on a server (the first start of a new database uses it).
POSTGRES_PASSWORD=change-me

# Host name and/or IP of the machine that runs Beepstock, comma separated. Goes into the self-signed HTTPS certificate
# (needed for the phone camera). Example for a server called server.example.lan:
TLS_HOSTS=server.example.lan,192.168.1.10

# Optional: protects /api and /ws with a token ("Authorization: Bearer <token>"). The web UI asks for it once.
# The ESP32 bridge sends it too (set it in its web portal). Empty = open inside your network.
API_TOKEN=

# Ports published on the host.
BEEPSTOCK_PORT=8080
BEEPSTOCK_HTTPS_PORT=8443

TZ=Europe/Berlin

# Optional behaviour defaults (can also be changed in the app under Einstellungen)
# MODE_IDLE_MINUTES=0
# DEFAULT_MODE=consume

# Where docker builds the app from. Default "." (this folder). On a server you do not need a checkout: let Docker build
# straight from the repository (docker compose up -d --build re-fetches the latest commit of that branch each time).
#   public repository:   BEEPSTOCK_SOURCE=https://github.com/teamoWeekend/BeepStock.git#main
#   private repository:  BEEPSTOCK_SOURCE=https://<fine-grained-token>@github.com/teamoWeekend/BeepStock.git#main
#                        (token with read-only "Contents" permission for this one repository; keep this .env private)
# BEEPSTOCK_SOURCE=
